# Copy this file to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables. Anything left empty runs in MOCK mode.

# --- Required on Vercel ---------------------------------------------------------
# Postgres connection string (Neon via Vercel Marketplace sets this for you).
# Leave empty locally to use a built-in database stored in .data/
DATABASE_URL=

# The public address of the app, e.g. https://york-hiring.vercel.app (no trailing slash).
APP_URL=http://localhost:5173

# Long random strings. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
INTERNAL_SECRET=change-me-too
SIGNALHIRE_WEBHOOK_SECRET=change-me-three
# Vercel sends this to /api/cron/daily automatically when set
CRON_SECRET=

# --- Providers (leave empty = mock mode) ------------------------------------------
ANTHROPIC_API_KEY=
# Or reach Claude through OpenCode Console instead (key starts with oc_sk_). Wins over ANTHROPIC_API_KEY.
# Through OpenCode the weekly half-price batch scoring and the web search step are not available.
OPENCODE_API_KEY=
# Optional: another OpenCode address, e.g. https://opencode.ai/inference/go/anthropic for OpenCode Go
OPENCODE_BASE_URL=
# Optional override of the Claude model
CLAUDE_MODEL=claude-sonnet-5-5

PDL_API_KEY=
SIGNALHIRE_API_KEY=

# Email sending through Resend (domain york-press.com must be verified in Resend)
RESEND_API_KEY=
# Sender used for system emails (approvals, reminders, invites)
EMAIL_FROM=York Press Hiring <hiring@york-press.com>

# --- CV storage (Vercel Blob, private store; empty = keep CVs in the database) -------
BLOB_READ_WRITE_TOKEN=

# --- Job queue for sourcing runs (Upstash QStash; empty = run in the background) ----
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Error monitoring (Sentry, optional; empty = off) -------------------------------
# Server errors (API, sourcing runs, cron)
SENTRY_DSN=
# Browser errors. Usually the same DSN. Vite reads it at build time.
VITE_SENTRY_DSN=
# Build-time only: upload source maps so stack traces are readable. Leave empty to skip.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Pull-request previews ---------------------------------------------------------
# Previews use sample data and the mock outbox. Set to true (Preview only) to use the real services.
PREVIEW_USE_REAL_SERVICES=

# --- Two-step login (optional) ------------------------------------------------------
# true = admin and CEO accounts must use an authenticator app code as well as the password
REQUIRE_TWO_FACTOR=

# --- Demo ---------------------------------------------------------------------
# true = create demo accounts for every role (password: demo-york-2026)
DEMO_MODE=true
